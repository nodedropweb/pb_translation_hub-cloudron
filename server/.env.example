# Unsplash API Configuration
UNSPLASH_APP_ID=your_unsplash_app_id_here
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
UNSPLASH_SECRET_KEY=your_unsplash_secret_key_here

# Database Configuration
DB_HOST=127.0.0.1
DB_USER=pb_hub
DB_PASSWORD=your_db_password_here
DB_NAME=pb_translation_hub

# Security
JWT_SECRET=your_jwt_secret_here

# Help screen tutorial videos (optional)
# Accepts https://youtu.be/<ID> or https://www.youtube.com/watch?v=<ID>
# Leave empty to hide the video panel in the help screen.
HELP_VIDEO_DE=
HELP_VIDEO_EN=
