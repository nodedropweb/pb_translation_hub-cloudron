# Unsplash API Configuration
UNSPLASH_APP_ID=your_unsplash_app_id_here
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
UNSPLASH_SECRET_KEY=your_unsplash_secret_key_here

# Database Configuration
DB_HOST=127.0.0.1
DB_USER=pb_hub
DB_PASSWORD=your_db_password_here
DB_NAME=pb_translation_hub

# Security
JWT_SECRET=your_jwt_secret_here

# Bootstraps the first admin account on startup if none exists yet — there's
# no in-app path to create one otherwise. Only acts once; ignored on every
# later boot once an admin account exists. ADMIN_EMAIL is optional.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Help screen tutorial videos (optional)
# Accepts https://youtu.be/<ID> or https://www.youtube.com/watch?v=<ID>
# Leave empty to hide the video panel in the help screen.
HELP_VIDEO_DE=
HELP_VIDEO_EN=

# Debug endpoints (optional). Leave unset to keep /api/*/debug/* routes disabled (403).
PB_DEBUG_KEY=
