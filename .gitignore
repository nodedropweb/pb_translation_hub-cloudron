# Backups (lokale Sicherungsarchive, von backup.sh erzeugt)
backups/

# Node / NPM
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Flutter Web Build
flutter_client/build/
flutter_client/.dart_tool/
flutter_client/.flutter-plugins
flutter_client/.flutter-plugins-dependencies
flutter_client/.metadata

# Flutter Platform-Specific (not needed for web deploy)
flutter_client/android/local.properties
flutter_client/ios/Pods/
flutter_client/macos/Pods/

# IDE / OS
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Project Data (live data, not in version control)
server/data/metadata/
server/data/translations/
server/data/status.json
server/data/*.sql.gz
server/uploads/
data.zip

# Logs and PIDs
server/*.log
flutter_client/*.log
server/*.pid

# Environment (sensitive config)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env

# Dev/Scratch Artifacts
scratch/
test-results/
tests/*.png
server/scratch/
.claude/
claude.md
tts_scripts/
*.mp3:Zone.Identifier
*.png:Zone.Identifier
*:Zone.Identifier
